{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../..",
  "modulePaths": [
    "<rootDir>"
  ],
  "testEnvironment": "node",
  "testRegex": "test/integration/.*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 60000,
  "maxWorkers": 2,
  "coverageThreshold": {
    "global": {
      "lines": 70,
      "branches": 44,
      "functions": 62
    }
  }
}
