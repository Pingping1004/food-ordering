// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OrderStatus {
  receive
  cooking
  ready
  done
  delay
  rejected
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  REMOVED
}

enum PaymentStatus {
  PENDING_VERIFICATION
  UNPAID
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum Role {
  ADMIN
  COOKER
  USER
}

enum SchoolRole {
    ADMIN
    STAFF
}

enum RestaurantRole {
  OWNER
  ADMIN
  STAFF
}

enum IsPaid {
  paid
  unpaid
  processing
  rejected
}

enum RestaurantCategory {
  Steak
  Halal
  Made_to_order
  Esan
  Rice
  Appetizer
  Noodle
}

model RoleRequest {
  requestId     String    @id @default(uuid())

  userId        String      @unique
  user          User        @relation(fields: [userId], references: [userId], onDelete: Cascade)

  requestRole   Role
  status        RoleRequestStatus

  createdAt 		DateTime 	@default(now()) 		@db.Timestamptz(3)
  updatedAt		DateTime	@updatedAt			@db.Timestamptz(3)

	@@index([userId])
	@@index([requestRole])
	@@index([status])
}

model School {
	schoolId			String		@default(uuid())		@id
	name			String		@unique
	email			String		@unique
	profile			String?
	studentAmount	Int
	status			Status

	canteens			Canteen[]
	schoolMemberships	SchoolMembership[]
	operatingHours 	SchoolOperatingHour[]
    	dateOverrides 	SchoolDateOverride[]

	createdAt 		DateTime 	@default(now()) 		@db.Timestamptz(3)
	updatedAt		DateTime	@updatedAt			@db.Timestamptz(3)

	@@index([name])
	@@index([email])
}

model Canteen {
	canteenId		String		@default(uuid())		@id
	name			String
	profile			String?
	status			Status

	schoolId			String
	school			School		@relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
	restaurants		Restaurant[]
	operatingHours 	CanteenOperatingHour[]

	createdAt 		DateTime 	@default(now()) 		@db.Timestamptz(3)
	updatedAt		DateTime	@updatedAt			@db.Timestamptz(3)

	@@index([name])
	@@index([schoolId])
	@@unique([schoolId, name])
}

model Restaurant {
	restaurantId  		String 		@default(uuid()) 		@id
  	name 			String
  	profile 			String?
  	email  			String 
  	location  			String?
  	categories  		RestaurantCategory[]
	maxActiveOrders	Int?
	avgCookingTimeMins	Int?
	status			Status
	isAutoAcceptedOrder	Boolean  @default(false)
  
  	contactName    	String
  	contactTel     		String
  	contactEmail   		String

	accountNumber	String
	accountName	String
	paymentQr		String

	canteenId		String
	canteen			Canteen		@relation(fields: [canteenId], references: [canteenId], onDelete: Cascade)
	memberships		RestaurantMembership[]
	operatingHours	RestaurantOperatingHour[]
	menus            		Menu[]
  	orders           		Order[]

	@@index([canteenId])
	@@unique([canteenId, name])
}

model Menu {
  	menuId  			String  		@default(uuid()) 		@id
  	name  			String
  	menuImg 		String?
  	price   			Int
  	maxDaily 		Int?
  	cookingTimeMins	Int
 	 isAvailable 		Boolean 		@default(true)
	createdAt 		DateTime 	@default(now()) 		@db.Timestamptz(3)
	updatedAt		DateTime	@updatedAt			@db.Timestamptz(3)

  	restaurantId  		String
 	restaurant  		Restaurant  	@relation(fields: [restaurantId], references: [restaurantId], onDelete: Cascade)
  	orderMenus  		OrderMenu[]

  	@@unique([restaurantId, name])
  	@@index([restaurantId])
  	@@index([isAvailable])
}

model Order {
  	orderId 			String 		@default(uuid()) 		@id
  	status  			OrderStatus 	@default(receive)
    details             String?
  	paymentStatus  	PaymentStatus	@default(UNPAID)
  	totalAmount   	Int
  	orderAt 			DateTime  	@default(now())		@db.Timestamptz(3)
  	pickupAt 		DateTime	@db.Timestamptz(3)
	paidAt			DateTime?	@db.Timestamptz(3)
  	isDelay 			Boolean 		@default(false)

  	restaurantId  		String
  	restaurant  		Restaurant  	@relation(fields: [restaurantId], references: [restaurantId], onDelete: Cascade)
  	orderMenus 		OrderMenu[]

  	@@index([restaurantId])
  	@@index([status])
	@@index([paymentStatus])
	@@index([pickupAt])
  	@@index([orderAt])
}

model OrderMenu {
  	orderMenuId      	String 		@default(uuid()) 		@id
	quantity   		Int
  	menuName   		String
  	menuImg   		String?
  	unitPrice 		Int
  	totalPrice 		Int

  	orderId 			String
  	order   			Order 		 @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  	menuId  			String
  	menu  			Menu  		@relation(fields: [menuId], references: [menuId], onDelete: Restrict)

  	@@index([menuId])
  	@@index([orderId])
}

model RestaurantMembership {
	id				String		@default(uuid())		@id
	role				RestaurantRole

	userId			String
	user				User		@relation(fields: [userId], references: [userId], onDelete: Cascade)
	restaurantId		String
	restaurant		Restaurant	@relation(fields: [restaurantId], references: [restaurantId], onDelete: Cascade)

	createdAt 		DateTime 	@default(now()) 		@db.Timestamptz(3)
   	updatedAt 		DateTime 	@updatedAt 			@db.Timestamptz(3)


	@@unique([userId, restaurantId])
	@@index([restaurantId])
}

model SchoolMembership {
	id			String	@default(uuid())	@id
	role				SchoolRole
	userId			String
	user				User		@relation(fields: [userId], references: [userId], onDelete: Cascade)
	schoolId			String
	school			School		@relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
	createdAt 		DateTime 	@default(now()) 		@db.Timestamptz(3)
	updatedAt		DateTime	@updatedAt			@db.Timestamptz(3)

	@@unique([userId, schoolId])
	@@index([schoolId])
}

model SchoolOperatingHour {
    	id 				String		 @default(uuid())			@id
   	schoolId 			String
	school   			School 		@relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
    	dayOfWeek 		DayOfWeek
    	openMinute  		Int
    	closeMinute 		Int

    	@@unique([schoolId, dayOfWeek])
    	@@index([schoolId])
}

model CanteenOperatingHour {
    id 				String 		@default(uuid())			@id
    canteenId		String
    canteen   		Canteen 		@relation(fields: [canteenId], references: [canteenId], onDelete: Cascade)
    dayOfWeek 		DayOfWeek
    openMinute  		Int
    closeMinute 		Int

    @@unique([canteenId, dayOfWeek])
    @@index([canteenId])
}


model RestaurantOperatingHour {
	id				String		 @default(uuid())			@id
	restaurantId	String
	restaurant		Restaurant	@relation(fields: [restaurantId], references: [restaurantId], onDelete: Cascade)
    dayOfWeek 		DayOfWeek
    openMinute		Int
    closeMinute 		Int

	@@unique([restaurantId, dayOfWeek])
	@@index([restaurantId])
}

model SchoolDateOverride {
    id 				String 		@default(uuid())			@id
    schoolId 		String
    school 			School 		@relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
    date 			DateTime 	@db.Date
    isClosed 		Boolean 		@default(false)
    openMinute  	Int?
    closeMinute 	Int?
    reason			String?

    createdAt 		DateTime 	@default(now()) 			@db.Timestamptz(3)
    updatedAt 		DateTime 	@updatedAt 				@db.Timestamptz(3)

    @@unique([schoolId, date])
    @@index([schoolId, date])
}

model User {
   	 userId 		String 		@default(uuid())		@id
    name 			String
    email 			String? 	@unique
	password		String
    role			Role        @default(USER)

    schoolMemberships SchoolMembership[]
    restaurantMemberships RestaurantMembership[]
    roleRequest     RoleRequest[]

    createdAt 		DateTime 	@default(now()) 		@db.Timestamptz(3)
    updatedAt 		DateTime 	@updatedAt 			@db.Timestamptz(3)
}