generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RoleRequest {
  requestId   String            @id @default(uuid())
  userId      String            @unique
  username    String
  requestRole Role
  status      RoleRequestStatus
  createdAt   DateTime          @default(now())
  updatedAt   DateTime?
  user        User              @relation("UserToRoleRequest", fields: [userId], references: [userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  jti       String   @unique
  userId    String
  expiresAt DateTime
  issuedAt  DateTime @default(now())
  isUsed    Boolean  @default(false)
  isRevoked Boolean  @default(false)
  user      User     @relation("UserToRefreshTokens", fields: [userId], references: [userId], onDelete: Cascade)
}

model Payout {
  payoutId          String     @id @default(uuid())
  idempotencyKey    String     @unique
  requestHash       String
  transactionId     String?    @unique
  grossAmount       Decimal    @db.Decimal(10, 2)
  restaurantRevenue Decimal    @db.Decimal(10, 2)
  platformFee       Decimal    @db.Decimal(10, 2)
  transactionFee    Decimal    @db.Decimal(10, 2)
  vat               Decimal    @db.Decimal(10, 2)
  refundAmount      Decimal?   @db.Decimal(10, 2)
  payoutStatus      PayoutStatus  @default(processing)
  startDate         DateTime
  endDate           DateTime
  paidAt            DateTime?
  refundAt          DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime    @updatedAt
  orderId           String     @unique
  restaurantName    String
  restaurantId      String
  order             Order      @relation("OrderToPayout", fields: [orderId], references: [orderId], onDelete: Cascade)
  restaurant        Restaurant @relation("RestaurantPayment", fields: [restaurantId], references: [restaurantId], onDelete: Cascade)

  @@index([payoutStatus, endDate])
  @@index([transactionId])

  @@unique([idempotencyKey, orderId])
}

model Restaurant {
  restaurantId        String               @id @default(uuid())
  email               String               @unique
  restaurantImg       String?
  name                String               @unique
  location            String?
  categories          RestaurantCategory[]
  openTime            String
  closeTime           String
  avgCookingTime      Int
  maxActiveOrder      Int?                @default(25)
  isApproved          Boolean             @default(false)
  isAutoAcceptedOrder          Boolean             @default(false)
  adminName           String
  adminSurname        String
  adminTel            String
  adminEmail          String

  accountNumber       String
  bankAccount         AccountType
  accountHolderFullName   String
  paymentQr           String              @unique

  openDate            DateWeek[]
  userId              String               @unique
  isTemporarilyClosed Boolean              @default(false)
  menus               Menu[]               @relation("RestaurantMenus")
  orders              Order[]              @relation("restaurantToOrder")
  payout              Payout[]             @relation("RestaurantPayment")
  user                User                 @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([restaurantId])
  @@index([openTime])
}

model Menu {
  menuId       String      @id @default(uuid())
  name         String
  menuImg      String
  price        Decimal     @db.Decimal(10, 2)
  maxDaily     Int         @default(100)
  cookingTime  Int?
  createdAt    DateTime    @default(now())
  isAvailable  Boolean     @default(true)
  restaurantId String
  restaurant   Restaurant  @relation("RestaurantMenus", fields: [restaurantId], references: [restaurantId], onDelete: Cascade)

  inventories   Inventory[]
  orderMenus   OrderMenu[] @relation("menuToOrderMenus")

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([isAvailable])
  @@index([cookingTime])
}

model Inventory {
  id          String    @id @default(uuid())
  menuId      String
  date        DateTime
  remaining   Int
  dailyQuota  Int

  menu        Menu      @relation(fields: [menuId], references: [menuId], onDelete: Cascade)

  @@unique([menuId, date])
}

model OrderMenu {
  orderMenuId String  @id @default(uuid())
  quantity    Int
  menuName    String
  menuImg     String?
  unitPrice   Decimal @db.Decimal(10, 2)
  maxDaily    Int
  orderId     String
  menuId      String
  menu        Menu    @relation("menuToOrderMenus", fields: [menuId], references: [menuId], onDelete: Cascade)
  order       Order   @relation("OrderToMenu", fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([menuId])
  @@index([orderId])
}

model Order {
  orderId              String      @id @default(uuid())
  orderSecret          String?      @default(uuid())    @unique
  status               OrderStatus @default(sent)
  userTel              String
  orderAt              DateTime    @default(now())
  acceptAt             DateTime?
  deliverAt            DateTime
  paymentStatus        PaymentStatus      @default(unpaid)
  isDelay              Boolean     @default(false)
  totalAmount          Decimal    @db.Decimal(10, 2)

  paidAt               DateTime?
  transactionId        String?     @unique
  paymentSlipImg       String?
  paymentMethod        String?     @map("payment_method_type")
  paymentGatewayStatus String?     @map("payment_gateway_status")
  
  updatedAt            DateTime    @updatedAt
  completedAt          DateTime?
  cancelledAt          DateTime?
  rejectedAt           DateTime?
  refundAt             DateTime?

  restaurantId         String
  restaurant           Restaurant  @relation("restaurantToOrder", fields: [restaurantId], references: [restaurantId], onDelete: Cascade)
  orderMenus           OrderMenu[] @relation("OrderToMenu")
  
  payoutId             String?
  payout               Payout?     @relation("OrderToPayout")
  userId               String?
  user                 User?       @relation("OrderToUser", fields: [userId], references: [userId], onDelete: Cascade)
  pushNotificationJobs PushNotificationJob[]
  pushDeliveries       PushDelivery[]

  @@index([restaurantId])
  @@index([restaurantId, orderAt])
  @@index([status])
  @@index([orderAt])
  @@index([payoutId])
  @@index([userTel])

  @@index([status, paymentStatus, acceptAt])
  @@index([status, paymentStatus, orderAt])
}

model User {
  userId        String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  profileImg    String?
  role          Role           @default(user)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[] @relation("UserToRefreshTokens")
  restaurant    Restaurant?
  RoleRequest   RoleRequest?   @relation("UserToRoleRequest")
  order         Order[]        @relation("OrderToUser")
  deviceTokens  DeviceToken[]
  pushNotificationJobs PushNotificationJob[]
  pushDeliveries PushDelivery[]

  @@index([name])
  @@index([userId])
  @@index([role])
}

model DeviceToken {
  deviceTokenId String   @id @default(uuid())
  token         String   @unique
  platform      String?
  userAgent     String?
  isActive      Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pushDeliveries PushDelivery[]

  @@index([userId, isActive])
}

model Events {
  eventId               String        @id @default(uuid())
  name                  EventName
  source                EventSource
  userId                String?
  restaurantId          String?
  metadata              Json?
  createdAt             DateTime      @default(now())

  @@index([restaurantId])
  @@index([userId])
  @@index([name])
  @@index([source])
  @@index([createdAt])
  @@index([restaurantId, createdAt])
  @@index([name, createdAt])
}

model PushNotificationJob {
  pushNotificationJobId String        @id @default(uuid())
  orderId               String
  userId                String
  restaurantId          String
  eventType             PushEventType
  attemptCount          Int           @default(0)
  maxAttempts           Int           @default(1)
  nextAttemptAt         DateTime      @default(now())
  lastAttemptAt         DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  lastError             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 Order         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pushDeliveries        PushDelivery[]

  @@unique([orderId, userId, eventType])
  @@index([nextAttemptAt, completedAt, cancelledAt])
}

model PushDelivery {
  pushDeliveryId        String        @id @default(uuid())
  orderId               String
  userId                String
  restaurantId          String
  eventType             PushEventType
  attemptNumber         Int
  success               Boolean
  providerMessageId     String?
  errorCode             String?
  errorMessage          String?
  createdAt             DateTime      @default(now())
  deviceTokenId         String?
  pushNotificationJobId String?
  deviceToken           DeviceToken?  @relation(fields: [deviceTokenId], references: [deviceTokenId], onDelete: SetNull)
  order                 Order         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pushNotificationJob   PushNotificationJob? @relation(fields: [pushNotificationJobId], references: [pushNotificationJobId], onDelete: SetNull)

  @@index([orderId, eventType, createdAt])
  @@index([userId, createdAt])
}

enum PayoutStatus {
  initiated
  processing
  success
  failed
}

enum PushEventType {
  new_order
  payment_verified
}

enum DateWeek {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

enum AccountType {
  BANGKOK_BANK        // 01002
  KASIKORN_BANK       // 01004
  KRUNG_THAI_BANK     // 01006
  TTB                 // 01011
  SCB                 // 01014
  KRUNGSRI            // 01025
  KKP                 // 01069
  CIMB_THAI           // 01022
  TISCO               // 01067
  UOB                 // 01024
  THAI_CREDIT         // 01071
  LH_BANK             // 01073
  ICBC_THAI           // 01070
  SME_BANK            // 01098
  BAAC                // 01034
  EXIM                // 01035
  GSB                 // 01030
  GHB                 // 01033
  ISLAMIC_BANK        // 01066

  PROMPTPAY_PHONE     // 02001
  PROMPTPAY_ID        // 02003
  PROMPTPAY_EWALLET   // 02004

  MERCHANT_QR         // 03000
  TRUEMONEY_WALLET    // 04000
}

enum RoleRequestStatus {
  pending
  accepted
  rejected
}

enum PaymentMethod {
  promptpay
  mobileBanking
  cash
}

enum PromptpayType {
  PHONE_NUMBER
  NATIONAL_ID
  EMAIL
}

enum OrderStatus {
  sent
  accepted
  cancelled
  rejected
  completed
}

enum Role {
  admin
  cooker
  user
  guest
}

enum PaymentStatus {
  paid
  unpaid
  verifying
  failed
  refund_pending
  refund_complete
}

enum RestaurantCategory {
  Steak
  Halal
  Made_to_order
  Esan
  Rice
  Appetizer
  Noodle
  Dessert
}

enum EventName {
  landing_page_viewed
  restaurant_viewed
  menu_viewed
  item_added
  checkout_started
  order_submitted

  order_accepted
  order_rejected
  order_paid
  order_cancelled
  order_completed
  order_delayed
  order_expired
  order_auto_accepted
  order_auto_rejected
  order_auto_cancelled
  menu_out_of_stock
  queue_limit_reached
  restaurant_closed
  restaurant_reopened

  websocket_disconnected
  websocket_reconnected
  api_request_failed
  duplicate_order_detected
  payment_verification_failed
}

enum EventSource {
  student_web
  restaurant_cms
  admin_panel
  backend_system
  cron_job
}